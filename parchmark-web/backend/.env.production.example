# Backend Production Environment Configuration
# Copy this file to .env.production on your production server
# WARNING: .env.production should NEVER be committed to version control

# Database Configuration
DATABASE_URL=postgresql://parchmark_user:parchmark_password@postgres:5432/parchmark_db

# JWT Configuration
# IMPORTANT: Generate a new SECRET_KEY using:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_TO_A_GENERATED_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
# Update with your actual production domains
ALLOWED_ORIGINS=https://notes.engen.tech,https://assets-api.engen.tech

# Artifact content origin: scheme and host that serve /a/<slug> share links.
# It must be a host separate from the app, with no path (e.g. https://artifacts.example.com).
ARTIFACT_CONTENT_ORIGIN=CHANGE_THIS_TO_THE_ARTIFACT_CONTENT_ORIGIN

# View-link signing key: a new random value of at least 32 characters, never SECRET_KEY.
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ARTIFACT_SIGNING_KEY=CHANGE_THIS_TO_A_GENERATED_SIGNING_KEY

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
