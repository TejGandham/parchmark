# ParchMark Backend Configuration
# This file is used for Docker-based environments.
# Copy to .env.docker and update values as needed.

# Environment variables for FastAPI application

# JWT Configuration
# Generate a secure secret key for production: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-generate-a-secure-one
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration
# Docker environment connects to postgres service
DATABASE_URL=postgresql://parchmark_user:parchmark_password@postgres:5432/parchmark_db

# Application Configuration
APP_NAME=ParchMark API
APP_VERSION=1.0.0
DEBUG=true

# CORS Configuration (for development)
# Add your frontend URLs separated by commas
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Artifact content origin: scheme and host that serve /a/<slug> share links (required)
ARTIFACT_CONTENT_ORIGIN=http://localhost:8000

# View-link signing key: a dedicated HMAC key of at least 32 characters, never SECRET_KEY (required)
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
ARTIFACT_SIGNING_KEY=dev-artifact-signing-key-change-in-production

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Logging Configuration
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
