{
  "name": "parchmark-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:tokens && vue-tsc --noEmit -p tsconfig.json && vite build",
    "build:tokens": "node src/design-system/tokens/build.mjs",
    "lint": "vue-tsc --noEmit -p tsconfig.json && prettier --check \"src/**/*.{ts,vue}\" \"src/design-system/base.css\" \"*.{html,json,ts}\"",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"src/design-system/base.css\" \"*.{html,json,ts}\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "dompurify": "^3.4.14",
    "marked": "^18.0.10",
    "ofetch": "^1.5.1",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "style-dictionary": "^5.5.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.10"
  }
}
